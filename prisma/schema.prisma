generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/* =========================
   USERS
========================= */
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String

  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])

  firstName  String
  middleName String?
  lastName   String
  contactNo  String?
  address    String?

  isActive   Boolean  @default(true)

  /* ---------- RELATIONS ---------- */
  children Child[]

  permissions UserPermission[]

  createdImmunizations ImmunizationRecord[] @relation("createdBy")
  updatedImmunizations ImmunizationRecord[] @relation("updatedBy")
  deletedImmunizations ImmunizationRecord[] @relation("deletedBy")

  /* ---------- SOFT DELETE ---------- */
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  deletedById Int?
  deletedBy   User?    @relation("UserDeletedBy", fields: [deletedById], references: [id])
  deletedUsers User[]  @relation("UserDeletedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================
   ROLES
========================= */
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?

  permissions RolePermission[]
  users       User[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?
}

/* =========================
   PERMISSIONS
========================= */
model Permission {
  id   Int            @id @default(autoincrement())
  code PermissionCode @unique

  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           Int @id @default(autoincrement())
  userId       Int
  permissionId Int
  allowed      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
}

/* =========================
   CHILD
========================= */
model Child {
  id        Int @id @default(autoincrement())
  parentId  Int

  firstName  String
  middleName String?
  lastName   String
  gender     Gender
  birthDate  DateTime
  birthPlace String

  parent User @relation(fields: [parentId], references: [id])

  immunizations ImmunizationRecord[]
  visits        ImmunizationVisit[]
  summary       ImmunizationSummary?

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================
   VACCINES
========================= */
model Vaccine {
  id             Int @id @default(autoincrement())
  name           String
  description    String?
  recommendedAge String

  totalDoses          Int?
  requiresBooster     Boolean @default(false)
  boosterAfterMonths  Int?

  immunizations ImmunizationRecord[]
  schedules     ImmunizationSchedule[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
}

/* =========================
   IMMUNIZATION SCHEDULE
   (AUTO-GENERATOR SOURCE)
========================= */
model ImmunizationSchedule {
  id        Int @id @default(autoincrement())

  vaccineId Int
  doseLabel String
  doseNumber Int
  recommendedAgeInMonths Int
  intervalDays Int?

  vaccine Vaccine @relation(fields: [vaccineId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

/* =========================
   IMMUNIZATION VISIT
========================= */
model ImmunizationVisit {
  id        Int @id @default(autoincrement())
  childId   Int
  visitDate DateTime
  location  String?
  nurseName String?

  records ImmunizationRecord[]

  child Child @relation(fields: [childId], references: [id])

  createdAt DateTime @default(now())
}

/* =========================
   IMMUNIZATION RECORD
========================= */
model ImmunizationRecord {
  id        Int @id @default(autoincrement())
  childId   Int
  vaccineId Int
  visitId   Int?

  dose        String
  doseNumber Int?
  dateGiven  DateTime?
  nextDueDate DateTime?

  status ImmunizationStatus @default(PENDING)

  administeredBy String?
  administeredAt String?
  batchNumber String?
  manufacturer String?
  remarks String?

  isMissed Boolean @default(false)
  isLate   Boolean @default(false)

  /* ---------- AUDIT ---------- */
  createdById Int
  updatedById Int?
  deletedById Int?

  createdBy User  @relation("createdBy", fields: [createdById], references: [id])
  updatedBy User? @relation("updatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("deletedBy", fields: [deletedById], references: [id])

  child   Child   @relation(fields: [childId], references: [id])
  vaccine Vaccine @relation(fields: [vaccineId], references: [id])
  visit   ImmunizationVisit? @relation(fields: [visitId], references: [id])

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================
   IMMUNIZATION SUMMARY
========================= */
model ImmunizationSummary {
  id        Int @id @default(autoincrement())
  childId   Int @unique

  totalRequired  Int
  totalCompleted Int
  totalMissed    Int
  completionRate Float

  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id])
}

/* =========================
   ANNOUNCEMENTS
========================= */
model Announcement {
  id       Int @id @default(autoincrement())
  title    String
  message  String
  isActive Boolean @default(true)

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
}

/* =========================
   ENUMS
========================= */

enum Gender {
  MALE
  FEMALE
}

enum ImmunizationStatus {
  PENDING
  COMPLETED
  SKIPPED
  CANCELLED
}

enum PermissionCode {
  VIEW_DASHBOARD
  VIEW_ANNOUNCEMENT


  MANAGE_CHILDREN
  MANAGE_PARENTS

  MANAGE_IMMUNIZATION
  MANAGE_VACCINES

  MANAGE_USERS
  MANAGE_ROLES

  MANAGE_ADMINISTRATION
}
