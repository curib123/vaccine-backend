generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* =========================
   USERS
========================= */
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  firstName  String
  middleName String?
  lastName   String
  contactNo  String?
  address    String?

  isActive Boolean @default(true)

  /* ---------- RELATIONS ---------- */
  children Child[]

  permissions UserPermission[]

  createdImmunizations ImmunizationRecord[] @relation("createdBy")
  updatedImmunizations ImmunizationRecord[] @relation("updatedBy")
  deletedImmunizations ImmunizationRecord[] @relation("deletedBy")

  notifications Notification[]
  auditLogs     AuditLog[]

  /* ---------- SOFT DELETE ---------- */
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  deletedById  Int?
  deletedBy    User?     @relation("UserDeletedBy", fields: [deletedById], references: [id])
  deletedUsers User[]    @relation("UserDeletedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================
   ROLES
========================= */
model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String?

  permissions RolePermission[]
  users       User[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?
}

/* =========================
   PERMISSIONS
========================= */
model Permission {
  id   Int            @id @default(autoincrement())
  code PermissionCode @unique

  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           Int @id @default(autoincrement())
  userId       Int
  permissionId Int
  allowed      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
}

/* =========================
   CHILD
========================= */
model Child {
  id       Int @id @default(autoincrement())
  parentId Int

  ranking     Int
  firstName  String
  middleName String?
  lastName   String
  gender     Gender
  birthDate  DateTime
  birthPlace String
  address    String?

  motherName     String?
  fatherName     String?
  birthHeightCm  Float?
  birthWeightKg  Float?
  healthCenter   String?
  barangay       String?
  familyNumber   String?

  parent User @relation(fields: [parentId], references: [id])

  immunizations ImmunizationRecord[]
  summary       ImmunizationSummary?
  notifications Notification[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================
   VACCINES
========================= */
model Vaccine {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  description    String?
  recommendedAge String

  totalDoses         Int?
  requiresBooster    Boolean @default(false)
  boosterAfterMonths Int?

  stockQuantity Int    @default(0)
  reorderLevel  Int    @default(10)
  displayOrder  Int    @default(0)
  unit          String @default("dose")

  immunizations ImmunizationRecord[]
  schedules     ImmunizationSchedule[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================
   IMMUNIZATION SCHEDULE
========================= */
model ImmunizationSchedule {
  id Int @id @default(autoincrement())

  vaccineId Int

  doseLabel            String
  doseNumber           Int
  recommendedAgeLabel  String
  dueDaysFromBirth     Int
  intervalDays         Int?

  vaccine Vaccine @relation(fields: [vaccineId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

/* =========================
   IMMUNIZATION RECORD
========================= */
model ImmunizationRecord {
  id        Int @id @default(autoincrement())
  childId   Int
  vaccineId Int

  dose          String
  doseNumber    Int?
  scheduleLabel String?
  dateGiven     DateTime?
  nextDueDate   DateTime?

  status ImmunizationStatus @default(PENDING)

  administeredBy String?
  administeredAt String?
  batchNumber    String?
  manufacturer   String?
  remarks        String?

  isMissed Boolean @default(false)
  isLate   Boolean @default(false)

  reminderSentAt           DateTime?
  statusNotificationSentAt DateTime?

  /* ---------- AUDIT ---------- */
  createdById Int
  updatedById Int?
  deletedById Int?

  createdBy User  @relation("createdBy", fields: [createdById], references: [id])
  updatedBy User? @relation("updatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("deletedBy", fields: [deletedById], references: [id])

  child         Child               @relation(fields: [childId], references: [id])
  vaccine       Vaccine             @relation(fields: [vaccineId], references: [id])
  notifications Notification[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================
   IMMUNIZATION SUMMARY
========================= */
model ImmunizationSummary {
  id      Int @id @default(autoincrement())
  childId Int @unique

  totalRequired  Int
  totalCompleted Int
  totalMissed    Int
  completionRate Float

  updatedAt DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id])
}

/* =========================
   NOTIFICATIONS
========================= */
model Notification {
  id       Int              @id @default(autoincrement())
  userId   Int
  childId  Int?
  recordId Int?

  title   String
  message String
  type    NotificationType

  emailStatus EmailDeliveryStatus @default(PENDING)
  emailedAt   DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())

  user   User                @relation(fields: [userId], references: [id])
  child  Child?              @relation(fields: [childId], references: [id])
  record ImmunizationRecord? @relation(fields: [recordId], references: [id])
}

/* =========================
   AUDIT LOGS
========================= */
model AuditLog {
  id          Int    @id @default(autoincrement())
  userId      Int?
  action      String
  entityType  String
  entityId    Int?
  description String
  metadata    Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

/* =========================
   ANNOUNCEMENTS
========================= */
model Announcement {
  id       Int    @id @default(autoincrement())
  title    String
  message  String
  isActive Boolean @default(true)

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
}

/* =========================
   ENUMS
========================= */
enum Gender {
  MALE
  FEMALE
}

enum ImmunizationStatus {
  PENDING
  COMPLETED
  SKIPPED
  CANCELLED
}

enum PermissionCode {
  VIEW_DASHBOARD
  VIEW_ANNOUNCEMENT

  MANAGE_CHILDREN
  MANAGE_PARENTS

  MANAGE_IMMUNIZATION
  MANAGE_VACCINES

  MANAGE_USERS
  MANAGE_ROLES

  MANAGE_ADMINISTRATION
}

enum NotificationType {
  SCHEDULE_CREATED
  UPCOMING_SCHEDULE
  STATUS_UPDATED
  LOW_STOCK
  STOCK_UPDATED
  CHILD_REGISTERED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}
