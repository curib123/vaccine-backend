generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/* =========================
   USERS (ALL ACCOUNTS)
========================= */
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String

  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])

  firstName  String
  middleName String?
  lastName   String
  contactNo  String?
  address    String?

  isActive   Boolean  @default(true)

  /* ---------- RELATIONS ---------- */
  children Child[]

  /* ---------- SOFT DELETE ---------- */
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  deletedById Int?
  deletedBy   User?    @relation("UserDeletedBy", fields: [deletedById], references: [id])
  deletedUsers User[]  @relation("UserDeletedBy")

  /* ---------- AUDIT ---------- */
  createdImmunizations ImmunizationRecord[] @relation("createdBy")
  updatedImmunizations ImmunizationRecord[] @relation("updatedBy")
  deletedImmunizations ImmunizationRecord[] @relation("deletedBy")

  /* ---------- PERMISSIONS ---------- */
  permissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================
   ROLES
========================= */
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // ADMIN, HEALTH, PARENT
  description String?

  permissions RolePermission[]
  users       User[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?
}

/* =========================
   PERMISSIONS (FEATURE-BASED)
   1 PERMISSION = 1 FEATURE
========================= */
model Permission {
  id   Int             @id @default(autoincrement())
  code PermissionCode  @unique

  roles RolePermission[]
  users UserPermission[]
}

/* =========================
   ROLE → PERMISSIONS
========================= */
model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

/* =========================
   USER → PERMISSION OVERRIDES
========================= */
model UserPermission {
  id           Int @id @default(autoincrement())
  userId       Int
  permissionId Int
  allowed      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
}

/* =========================
   CHILD
========================= */
model Child {
  id        Int @id @default(autoincrement())
  parentId  Int

  firstName  String
  middleName String?
  lastName   String
  gender     Gender
  birthDate  DateTime
  birthPlace String

  parent         User @relation(fields: [parentId], references: [id])
  immunizations  ImmunizationRecord[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================
   VACCINES
========================= */
model Vaccine {
  id             Int @id @default(autoincrement())
  name           String
  description    String?
  recommendedAge String

  immunizations ImmunizationRecord[]

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
}

/* =========================
   IMMUNIZATION RECORDS
========================= */
model ImmunizationRecord {
  id        Int @id @default(autoincrement())
  childId   Int
  vaccineId Int

  dose            String
  dateGiven       DateTime
  administeredBy  String

  /* ---------- AUDIT ---------- */
  createdById Int
  updatedById Int?
  deletedById Int?

  createdBy User  @relation("createdBy", fields: [createdById], references: [id])
  updatedBy User? @relation("updatedBy", fields: [updatedById], references: [id])
  deletedBy User? @relation("deletedBy", fields: [deletedById], references: [id])

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  child   Child   @relation(fields: [childId], references: [id])
  vaccine Vaccine @relation(fields: [vaccineId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* =========================
   ANNOUNCEMENTS
========================= */
model Announcement {
  id       Int @id @default(autoincrement())
  title    String
  message  String
  isActive Boolean @default(true)

  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
}

/* =========================
   ENUMS
========================= */

/* 🔐 FEATURE-BASED PERMISSIONS
   (DERIVED FROM SIDEBAR LINKS)
*/
enum PermissionCode {
  VIEW_DASHBOARD

  MANAGE_CHILDREN
  MANAGE_PARENTS

  MANAGE_IMMUNIZATION
  MANAGE_VACCINES

  MANAGE_USERS
  MANAGE_ROLES

  MANAGE_ADMINISTRATION
}

enum Gender {
  MALE
  FEMALE
}
